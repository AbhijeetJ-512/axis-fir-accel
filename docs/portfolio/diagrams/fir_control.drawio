<diagram id="axis_fir_accel---control-and-credit-flow" name="axis_fir_accel - control and credit flow">
<mxGraphModel dx="1300" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="760" math="0" shadow="0"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="cog" value="coefficient reload: atomic at a frame boundary" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="1260" height="225" as="geometry"/></mxCell>
<mxCell id="crg" value="credit_ctr - why the output FIFO can never overflow" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="690" y="50" width="590" height="420" as="geometry"/></mxCell>
<mxCell id="fsm" value="fir_ctrl run FSM" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#888888;dashed=1;dashPattern=8 4;verticalAlign=bottom;align=left;spacingLeft=8;spacingTop=4;spacingBottom=4;fontStyle=1;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="640" height="420" as="geometry"/></mxCell>
<mxCell id="idle" value="&lt;b&gt;IDLE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;nothing admitted;&lt;br&gt;reset state&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#111111;fontSize=13;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="run" value="&lt;b&gt;RUN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;admit while credit&lt;br&gt;and data are available&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#111111;fontSize=13;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="450" y="100" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="drain" value="&lt;b&gt;DRAIN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;finish admitted samples,&lt;br&gt;admit no new ones&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#111111;fontSize=13;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="450" y="300" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="err" value="&lt;b&gt;CFGERR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;illegal CFG enabled;&lt;br&gt;sticky CFG_ERR, irq&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#111111;fontSize=13;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="180" height="70" as="geometry"/></mxCell>
<mxCell id="c0" value="&lt;b&gt;credits  (reset = OUT_FIFO_DEPTH)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;have_credit = (credits != 0)&lt;br&gt;consume and restore in one cycle: unchanged&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="250" height="80" as="geometry"/></mxCell>
<mxCell id="c1" value="&lt;b&gt;consume  (-1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;fir_ctrl admits a sample&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="1010" y="100" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="c2" value="&lt;b&gt;restore  (+1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;out_pop = m_axis_tvalid &amp;amp;&amp;amp; m_axis_tready&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="1010" y="215" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;Invariant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;samples in flight + out_fifo occupancy  &amp;lt;=  OUT_FIFO_DEPTH&lt;br&gt;so the output FIFO is never written while full - a counting argument, not a stall net.&lt;br&gt;Check at elaboration: OUT_FIFO_DEPTH &amp;gt; 5 + clog2(MAC_UNITS), else II = 1 is lost&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="720" y="330" width="530" height="95" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;write COEFF[i]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;AXI4-Lite, lands in the SHADOW bank&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="50" y="545" width="250" height="80" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;CTRL.COEFF_COMMIT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;STATUS.COEFF_PENDING = 1&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="350" y="545" width="250" height="80" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;frame_boundary || idle ?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;boundary = a TLAST beat has&lt;br&gt;LEFT the IP (output pop)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="540" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="s4" value="&lt;b&gt;swap  (bank_sel toggles)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;PENDING clears; the next frame&lt;br&gt;uses the new coefficients&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="990" y="545" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="s5" value="&lt;b&gt;wait&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;the frame in progress keeps the OLD coefficients&lt;/font&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#999933;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="655" width="300" height="48" as="geometry"/></mxCell>
<mxCell id="f1" value="DRAIN exists so that stopping loses nothing: dropping ENABLE mid-stream still delivers every admitted sample&lt;br&gt;(measured: beats out == SAMPLE_CNT).  FLUSH and SOFT_RESET discard by definition." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#222222;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="405" width="673.28" height="33.5" as="geometry"/></mxCell>
