<mxfile host="app.diagrams.net" agent="dgm.py" version="24.0.0">
<diagram id="axis_fir_accel---sample-flow" name="axis_fir_accel - sample flow">
<mxGraphModel dx="1300" dy="1130" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1130" math="0" shadow="0"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="s" value="&lt;b&gt;Sample waiting on s_axis_*&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;accepted into in_fifo while it is not full&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="460" y="40" width="380" height="52" as="geometry"/></mxCell>
<mxCell id="d1" value="&lt;b&gt;state == RUN ?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;ENABLE set and configuration legal&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="120" width="360" height="72" as="geometry"/></mxCell>
<mxCell id="d2" value="&lt;b&gt;in_fifo not empty ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="222" width="360" height="72" as="geometry"/></mxCell>
<mxCell id="d3" value="&lt;b&gt;credit available ?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;credits != 0 (output slot guaranteed)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="324" width="360" height="72" as="geometry"/></mxCell>
<mxCell id="d4" value="&lt;b&gt;core free ?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;not busy, or last pass of previous sample&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="426" width="360" height="72" as="geometry"/></mxCell>
<mxCell id="p1" value="&lt;b&gt;sample_start&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;pop in_fifo, consume one credit,&lt;br&gt;shift the delay line ONCE, capture TLAST (tlast_q)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="440" y="530" width="420" height="86" as="geometry"/></mxCell>
<mxCell id="p2" value="&lt;b&gt;pass p  (p = 0 ... P-1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;tap_base = p * MAC_UNITS; symmetric: pre-add x[n-k] + x[n-(N-1-k)];&lt;br&gt;inactive taps: BOTH operands gated to 0 (0 * X would be X)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="440" y="650" width="420" height="86" as="geometry"/></mxCell>
<mxCell id="p3" value="&lt;b&gt;multiply, adder tree, fold accumulate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;acc_first clears the accumulator, acc_last releases it&lt;br&gt;ACC_W bits: overflow impossible by construction&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="440" y="770" width="420" height="70" as="geometry"/></mxCell>
<mxCell id="d5" value="&lt;b&gt;last pass ?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;p == P - 1&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="868" width="360" height="72" as="geometry"/></mxCell>
<mxCell id="p4" value="&lt;b&gt;round_sat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;round (3 modes) then saturate; sat_event sets sticky bit&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="440" y="968" width="420" height="70" as="geometry"/></mxCell>
<mxCell id="p5" value="&lt;b&gt;push {data, TLAST} to out_fifo&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#111111;fontSize=12;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="440" y="1060" width="420" height="56" as="geometry"/></mxCell>
<mxCell id="w" value="&lt;b&gt;wait&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;IDLE / CFGERR: nothing is admitted&lt;br&gt;no data: nothing is admitted&lt;br&gt;no credit: output side is backed up&lt;br&gt;core busy: next sample waits for its last pass&lt;/font&gt;" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#999933;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="530" width="330" height="120" as="geometry"/></mxCell>
<mxCell id="o" value="&lt;b&gt;Output side&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;m_axis_tvalid = !out_fifo empty&lt;br&gt;beat leaves when m_axis_tready&lt;br&gt;out_pop: restore one credit&lt;br&gt;out_pop &amp;amp;&amp;amp; TLAST = frame_boundary:&lt;br&gt;shadow -&amp;gt; active swap, FRAME_DONE&lt;/font&gt;" style="shape=process;backgroundOutline=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#111111;fontSize=11;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="940" y="530" width="340" height="130" as="geometry"/></mxCell>
<mxCell id="w2" value="Re-evaluated every cycle: a sample is&lt;br&gt;admitted in the first cycle all four&lt;br&gt;conditions hold." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#222222;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="660" width="235.92" height="47.25" as="geometry"/></mxCell>
<mxCell id="t" value="A new sample_start may occur in the&lt;br&gt;same cycle as the last pass of the&lt;br&gt;previous sample: the delay line shifts&lt;br&gt;on the edge where that pass captures&lt;br&gt;its operands. So II = P cycles exactly." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#222222;fontStyle=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="940" y="700" width="248.24" height="74.75" as="geometry"/></mxCell>
